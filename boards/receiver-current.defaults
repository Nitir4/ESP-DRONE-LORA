# Current custom receiver. Existing ESP-Drone sensor/LED/motor settings stay modular.
CONFIG_TARGET_ESPLANE_V1=y
CONFIG_TRANSPORT_LORA=y
CONFIG_WIFI_BENCH_NO_MOTORS=y
CONFIG_MOTORS_STARTUP_TEST=n
CONFIG_BUZZER_ON=n
CONFIG_PROJECT_STATUS_LEDS=y
CONFIG_I2C0_PIN_SDA=22
CONFIG_I2C0_PIN_SCL=21
CONFIG_MPU_PIN_INT=27
CONFIG_LED_PIN_BLUE=26
CONFIG_LED_PIN_GREEN=25
CONFIG_LED_PIN_RED=33
CONFIG_MOTOR01_PIN=4
CONFIG_MOTOR02_PIN=32
CONFIG_MOTOR03_PIN=12
CONFIG_MOTOR04_PIN=13
CONFIG_BOARD_LORA_NSS=5
CONFIG_BOARD_LORA_SCK=18
CONFIG_BOARD_LORA_MISO=19
CONFIG_BOARD_LORA_MOSI=23
CONFIG_BOARD_LORA_RST=14
CONFIG_BOARD_LORA_DIO0=2
CONFIG_GPS_ENABLED=y
CONFIG_GPS_UART_NUM=2
CONFIG_GPS_RX_GPIO=16
CONFIG_GPS_TX_GPIO=17
CONFIG_GPS_BAUD=9600
CONFIG_GPS_TELEMETRY_ENABLED=y
CONFIG_GPS_TELEMETRY_PERIOD_MS=1000
# CONFIG_GPS_PRINT_NMEA is not set

CONFIG_PROJECT_GPS_SUPPORT=y
